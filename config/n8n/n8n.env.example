# ==============================================================================
# BI Antivirus - Genuine n8n Community Edition Configuration Template
# PLACEHOLDER TEMPLATE - DO NOT STORE PRODUCTION KEYS IN THIS REPOSITORY
# ==============================================================================

# Network & Loopback Binding (Strictly Localhost)
N8N_HOST=127.0.0.1
N8N_PORT=5679
N8N_LISTEN_ADDRESS=127.0.0.1
N8N_PROTOCOL=http
WEBHOOK_URL=http://127.0.0.1:5679/

# Task Runner / Broker Port Separation (Broker on 5680, Web UI on 5679)
N8N_RUNNERS_BROKER_PORT=5680
N8N_RUNNERS_BROKER_LISTEN_ADDRESS=127.0.0.1

# Persistent Storage & State on D: drive
N8N_USER_FOLDER=D:\bit defender\data\n8n
N8N_DEFAULT_BINARY_DATA_MODE=filesystem
N8N_BINARY_DATA_STORAGE_PATH=D:\bit defender\data\n8n\binaryData

# Security & Encryption Key (Generate a 64-character hex key)
N8N_ENCRYPTION_KEY=YOUR_SECURE_N8N_ENCRYPTION_KEY_64_HEX_CHARS
NODES_EXCLUDE=["n8n-nodes-base.executeCommand","n8n-nodes-base.ssh"]
N8N_COMMUNITY_PACKAGES_ENABLED=false
N8N_RESTRICT_FILE_ACCESS_TO=D:\bit defender

# Logging on D: drive
N8N_LOG_LEVEL=info
N8N_LOG_OUTPUT=file,console
N8N_LOG_FILE_LOCATION=D:\bit defender\logs\n8n\n8n.log

# Privacy & Telemetry Hardening
N8N_DIAGNOSTICS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
N8N_TEMPLATES_ENABLED=false
N8N_HIRING_BANNER_ENABLED=false

# BI Antivirus Integration Key (Matches D:\bit defender\data\api_key.txt)
BI_ANTIVIRUS_API_KEY=YOUR_ROTATED_BI_ANTIVIRUS_API_KEY_HERE
BI_ANTIVIRUS_API_URL=http://127.0.0.1:8765
