# ==============================================================================
# BI Antivirus Enterprise - Environment Configuration Template
# Copy this file to .env or set environment variables as needed.
# NO REAL CREDENTIALS, SECRETS, OR TOKENS SHOULD BE STORED HERE.
# ==============================================================================

# Project Workspace Root (Optional: defaults to auto-detected repository directory)
# BI_PROJECT_ROOT=D:\bit defender

# Execution Mode (0 = Production, 1 = Safe Automated Test Mode with Dry-Run Netsh)
BI_TEST_MODE=0

# REST API & Webhook Service Port
BI_API_PORT=8000
BI_API_HOST=127.0.0.1

# SIEM Telemetry Export Configuration (Optional)
BI_SIEM_ENABLED=0
BI_SIEM_HOST=127.0.0.1
BI_SIEM_PORT=514
BI_SIEM_PROTOCOL=UDP
BI_SIEM_FORMAT=CEF

# Fleet Controller mTLS Settings (Optional)
BI_FLEET_PORT=8443
BI_FLEET_HEARTBEAT_INTERVAL=30
